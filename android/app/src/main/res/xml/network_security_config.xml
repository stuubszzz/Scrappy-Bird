<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. No user-added CAs are trusted, which blocks most proxy/MITM tooling on unrooted devices. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
